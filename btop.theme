# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#040704"

# Main text color
theme[main_fg]="#d3d7b5"

# Title color for boxes
theme[title]="#daddc0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e33d84"

# Background color of selected item in processes box
theme[selected_bg]="#e33d84"

# Foreground color of selected item in processes box
theme[selected_fg]="#040704"

# Color of inactive/disabled text
theme[inactive_fg]="#969b83"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#daddc0"

# Background color of the percentage meters
theme[meter_bg]="#1d201d"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#d54a8e"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#8fa20a"
theme[mem_box]="#954144"
theme[net_box]="#954144"
theme[proc_box]="#8fa20a"

# Box divider line and small boxes line color
theme[div_line]="#585d58"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8fa20a"
theme[temp_mid]="#d3dd2c"
theme[temp_end]="#ee585d"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#969b83"
theme[cpu_mid]="#d54a8e"
theme[cpu_end]="#e33d84"

# Mem/Disk free meter
theme[free_start]="#585d58"
theme[free_mid]="#8fa20a"
theme[free_end]="#89974a"

# Mem/Disk cached meter
theme[cached_start]="#585d58"
theme[cached_mid]="#954144"
theme[cached_end]="#d54a8e"

# Mem/Disk available meter
theme[available_start]="#585d58"
theme[available_mid]="#969b83"
theme[available_end]="#8fa20a"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#969b83"
theme[used_mid]="#d54a8e"
theme[used_end]="#ee585d"

# Download graph colors
theme[download_start]="#585d58"
theme[download_mid]="#969b83"
theme[download_end]="#8fa20a"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#954144"
theme[upload_mid]="#d54a8e"
theme[upload_end]="#e33d84"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#969b83"
theme[process_mid]="#954144"
theme[process_end]="#e33d84"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#040704"
theme[gradient_color_1]="#1d201d"
theme[gradient_color_2]="#3e4438"
theme[gradient_color_3]="#585d58"
theme[gradient_color_4]="#747b65"
theme[gradient_color_5]="#969b83"
theme[gradient_color_6]="#b5bba0"
theme[gradient_color_7]="#d3d7b5"
